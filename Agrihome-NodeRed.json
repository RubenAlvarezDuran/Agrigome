  {
    "id": "aghf0036",
    "type": "function",
    "name": "Preparar CSV mediciones",
    "func": "// Prepara una fila CSV por muestra (31 columnas). Escribe el encabezado una sola vez.\nconst COLS = [\"timestamp_iso\", \"soil1_raw\", \"soil2_raw\", \"soil_avg_raw\", \"lux\", \"uv_raw\", \"temperature_c\", \"humidity_pct\", \"pump_state\", \"leds_state\", \"modo_autonomo\", \"soil1_dry\", \"soil2_dry\", \"any_soil_dry\", \"low_light\", \"auto_pump_running\", \"soil_dry_threshold\", \"lux_low_threshold\", \"pump_on_time_ms\", \"pump_cooldown_ms\", \"current_hour\", \"current_minute\", \"night_mode_enabled\", \"night_start_hour\", \"night_end_hour\", \"night_time\", \"leds_blocked_by_night\", \"wifi_rssi\", \"mqtt_connected\", \"ble_connected\", \"uptime_ms\"];\nconst intervalo = (flow.get('csv_interval_s') ?? 1) * 1000;  // 1 s = tiempo real; 30 s = larga duración\nconst ahora = Date.now();\nif (ahora - (flow.get('csv_last_ms') || 0) < intervalo - 50) return null;\nflow.set('csv_last_ms', ahora);\nconst d = Object.assign({}, msg.payload, { timestamp_iso: new Date(ahora).toISOString() });\nconst esc = v => {\n  if (v === undefined || v === null) return '';\n  const s = String(v);\n  return /[\",\\n\\r]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s;\n};\nconst fila = COLS.map(c => esc(d[c])).join(',');\nlet salida = fila;\nif (!flow.get('agrihome_csv_header_written')) {\n  salida = COLS.join(',') + '\\n' + fila;\n  flow.set('agrihome_csv_header_written', true);\n}\nconst n = (flow.get('csv_rows') || 0) + 1;\nflow.set('csv_rows', n);\nnode.status({ fill: 'green', shape: 'dot', text: n + ' filas' });\nreturn [{ payload: salida }, { payload: `Grabando · ${n} filas · cada ${intervalo / 1000} s` }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
