  {
    "id": "aghf0023",
    "type": "function",
    "name": "Enviar configuración",
    "func": "// Guarda los cambios del dashboard y construye SET_CONFIG.\n// Los tiempos se capturan en segundos y el firmware los recibe en milisegundos.\nconst cfg = flow.get('cfg') || {};\nconst t = msg.topic;\nif (t === 'save' || t === 'sync_time' || t === 'night_mode_enabled') {\n  if (t === 'night_mode_enabled') cfg.night_mode_enabled = !!msg.payload;\n  if (t === 'sync_time') { const now = new Date(); cfg.current_hour = now.getHours(); cfg.current_minute = now.getMinutes(); }\n  flow.set('cfg', cfg);\n  const out = { cmd: 'SET_CONFIG' };\n  const map = { soil_dry_threshold: 'soil_dry_threshold', lux_low_threshold: 'lux_low_threshold',\n                night_start_hour: 'night_start_hour', night_end_hour: 'night_end_hour', night_mode_enabled: 'night_mode_enabled' };\n  for (const k in map) if (cfg[k] !== undefined) out[map[k]] = cfg[k];\n  if (cfg.pump_on_s !== undefined) out.pump_on_time_ms = Math.round(cfg.pump_on_s * 1000);\n  if (cfg.pump_cooldown_s !== undefined) out.pump_cooldown_ms = Math.round(cfg.pump_cooldown_s * 1000);\n  if (t === 'sync_time') { out.current_hour = cfg.current_hour; out.current_minute = cfg.current_minute; }\n  node.status({ fill: 'green', shape: 'dot', text: 'SET_CONFIG enviado ' + new Date().toLocaleTimeString() });\n  return { payload: JSON.stringify(out) };\n}\ncfg[t] = msg.payload;\nflow.set('cfg', cfg);\nnode.status({ fill: 'yellow', shape: 'ring', text: 'Cambios sin guardar' });\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "aghmo0001"
      ]
    ],
    "z": "aghtab000000001",
    "x": 1250,
    "y": 1000
  },
  {
    "id": "aghf0033",
    "type": "function",
    "name": "Actualizar parámetros",
    "func": "// Toma los parámetros confirmados por el ESP32 (agrihome/status) y actualiza el dashboard\nconst d = msg.payload || {};\nconst cfg = flow.get('cfg') || {};\nconst set = (k, v) => { if (v !== undefined && v !== null) cfg[k] = v; return v; };\nconst soil = set('soil_dry_threshold', d.soil_dry_threshold);\nconst lux = set('lux_low_threshold', d.lux_low_threshold);\nconst pon = set('pump_on_s', d.pump_on_time_ms !== undefined ? d.pump_on_time_ms / 1000 : undefined);\nconst pcd = set('pump_cooldown_s', d.pump_cooldown_ms !== undefined ? d.pump_cooldown_ms / 1000 : undefined);\nconst ns = set('night_start_hour', d.night_start_hour);\nconst ne = set('night_end_hour', d.night_end_hour);\nconst nm = set('night_mode_enabled', d.night_mode_enabled);\nflow.set('cfg', cfg);\nconst m = v => v === undefined ? null : { payload: v };\nreturn [m(soil), m(lux), m(pon), m(pcd), m(ns), m(ne), m(nm), { payload: d.status || '—' }];",
