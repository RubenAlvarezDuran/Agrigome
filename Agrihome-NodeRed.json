  {
    "id": "aghf0022",
    "type": "function",
    "name": "Separar variables",
    "func": "// Separa la telemetría JSON del ESP32 en salidas para el dashboard\nconst d = msg.payload || {};\nconst num = v => (v === undefined || v === null || v === '') ? null : Number(v);\nconst thr = num(d.soil_dry_threshold) ?? 1500;\nconst s1 = num(d.soil1_raw), s2 = num(d.soil2_raw), sa = num(d.soil_avg_raw);\nconst lux = num(d.lux), uv = num(d.uv_raw), t = num(d.temperature_c), h = num(d.humidity_pct);\n// Regla OR del firmware: seco si cualquier sensor supera el umbral (RAW > umbral)\nconst seco1 = s1 !== null && s1 > thr, seco2 = s2 !== null && s2 > thr;\nconst suelo = (seco1 || seco2) ? `SECO (S1:${seco1 ? 'seco' : 'ok'} · S2:${seco2 ? 'seco' : 'ok'})` : 'Húmedo';\nlet luz = 'Sin dato';\nif (lux !== null) luz = lux < 50 ? 'Muy oscuro' : lux < 500 ? 'Luz baja' : lux < 3000 ? 'Aceptable' : 'Buena luz';\nlet uvTxt = 'Sin dato';  // bandas de presentación, no índice UV calibrado\nif (uv !== null) uvTxt = uv < 300 ? 'Bajo' : uv < 1000 ? 'Moderado' : uv < 2000 ? 'Alto' : 'Muy alto';\nconst rssi = num(d.wifi_rssi);\nconst hh = String(d.current_hour ?? '--').padStart(2, '0'), mm = String(d.current_minute ?? '--').padStart(2, '0');\nconst noche = `${hh}:${mm} · ${d.night_time ? 'Noche' : 'Día'}${d.leds_blocked_by_night ? ' · LEDs bloqueados' : ''}`;\nconst m = (p, topic) => p === null ? null : { payload: p, topic };\nreturn [\n  m(s1), m(s2), m(sa), m(lux), m(uv), m(t), m(h),\n  { payload: suelo }, { payload: luz }, { payload: uvTxt },\n  { payload: rssi === null ? 'Sin dato' : `${rssi} dBm` }, { payload: noche },\n  [m(s1, 'Suelo 1'), m(s2, 'Suelo 2'), m(sa, 'Promedio')],\n  [m(lux, 'Lux'), m(uv, 'UV RAW')],\n  [m(t, 'Temperatura'), m(h, 'Humedad')],\n  { payload: d.pump_state ? 'PUMP_ON' : 'PUMP_OFF' },\n  { payload: d.leds_state ? 'LEDS_ON' : 'LEDS_OFF' },\n  { payload: d.modo_autonomo ? 'AUTO_ON' : 'AUTO_OFF' }\n];",
    "outputs": 18,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
